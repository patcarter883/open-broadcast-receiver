# syntax=docker/dockerfile:1
# Bonding-rig router image: the rist2rist bonding hop (FIXPLAN M1.6) built
# from the vendored librist fork's tools/, plus tc/iproute2 for netem WAN
# shaping and conntrack for the CGNAT-churn case. Mirrors the OpenWrt
# luci-app-rist2rist deployment (one RIST in, one peer out per WAN path,
# all to the SAME receiver port).
#
# librist source: external/rist-cpp/rist is GENERATED by ExternalProject_Add
# (see external/rist-cpp/CMakeLists.txt) and gitignored, so it does not exist
# in a fresh checkout — the COPY this file used to do could never resolve,
# which is why every nightly rig run died at image build. Fetch the pinned,
# patched tree instead, deriving the pin from the wrapper's CMakeLists so the
# rig can never drift onto a different librist than production: the rig exists
# to characterise production behaviour (CGNAT source rebinding in particular).
FROM ubuntu:24.04 AS build
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    build-essential meson ninja-build pkg-config git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src

COPY external/rist-cpp/CMakeLists.txt external/rist-cpp/CMakeLists.txt
COPY external/rist-cpp/patches external/rist-cpp/patches
RUN set -eux; \
    pin=external/rist-cpp/CMakeLists.txt; \
    repo=$(sed -n -e 's|.*GIT_REPOSITORY \([^ ]*\).*|\1|p' "$pin" | head -n1); \
    tag=$(sed -n -e 's|.*GIT_TAG \([^ ]*\).*|\1|p' "$pin" | head -n1); \
    patch=$(sed -n -e 's|.*patches/\([^ "]*\.patch\).*|\1|p' "$pin" | head -n1); \
    test -n "$repo"   || { echo "ERROR: no GIT_REPOSITORY in $pin" >&2; exit 1; }; \
    test -n "$tag"    || { echo "ERROR: no GIT_TAG in $pin" >&2; exit 1; }; \
    test -n "$patch"  || { echo "ERROR: no patch in $pin PATCH_COMMAND" >&2; exit 1; }; \
    echo "librist pin (from rist-cpp/CMakeLists.txt): $repo @ $tag, patch $patch"; \
    git clone --depth 1 --branch "$tag" "$repo" rist; \
    git -C /src/rist apply "/src/external/rist-cpp/patches/$patch"; \
    git -C /src/rist apply --reverse --check "/src/external/rist-cpp/patches/$patch" \
      || { echo "ERROR: librist patch did not apply" >&2; exit 1; }

# Same meson switches as the production librist build, plus built_tools so
# tools/rist2rist is produced.
RUN meson setup build rist \
      -Ddefault_library=static -Dtest=false -Dbuilt_tools=true \
      -Dbuiltin_mbedtls=true -Dbuiltin_cjson=true -Dbuiltin_lz4=true \
      -Dc_args=-Wno-overlength-strings \
    && ninja -C build tools/rist2rist

FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    iproute2 iputils-ping conntrack \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/build/tools/rist2rist /usr/local/bin/
COPY test/rig/bond.sh /usr/local/bin/bond.sh
RUN chmod +x /usr/local/bin/bond.sh
ENTRYPOINT ["bond.sh"]
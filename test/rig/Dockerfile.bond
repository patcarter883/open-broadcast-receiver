# syntax=docker/dockerfile:1
# Bonding-rig router image: the rist2rist bonding hop (FIXPLAN M1.6), plus
# tc/iproute2 for netem WAN shaping and conntrack for the CGNAT-churn case.
#
# The hop MUST be the PRODUCTION tool, not upstream's. The production bridge
# (openwrt luci-app-rist2rist, rist2rist-tool.c) is a patched rist2rist that
#   1. accepts -P/--out-profile. Upstream hardcodes RIST_PROFILE_MAIN for its
#      output context, and MAIN has NO OOB channel at all, so the encoder could
#      never be reached with telemetry; and
#   2. emits the raw 5-byte wan_telemetry struct over RIST OOB to its LAN-side
#      peer (the encoder) from telemetry_emit(), driven by its own downstream
#      sender-peer stats — reports min(downstream q_out, input-leg receiver-flow
#      quality) so loss on EITHER leg pulls the encoder down. This is the ONLY
#      input to the encoder's bitrate_source::remote_oob.
#
# bond.sh already passes -p 2 -P 2 and depends on that telemetry (see its
# comments), so building upstream here would give a hop that refuses -P and
# emits nothing while looking perfectly healthy. The production tool is staged
# at test/rig/rist2rist-tool.c; keep it in step with
# ~/workspace/reviews/luci-app-rist2rist/rist2rist-tool.c.
#
# librist stays pinned to the same upstream tag the receiver links (derived from
# external/rist-cpp/CMakeLists.txt), so the rig cannot drift onto a different
# librist than production.
FROM ubuntu:24.04 AS build
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    build-essential meson ninja-build pkg-config git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src

COPY external/rist-cpp/CMakeLists.txt external/rist-cpp/CMakeLists.txt
COPY test/rig/rist2rist-tool.c test/rig/rist2rist-tool.c
RUN set -eux; \
    pin=external/rist-cpp/CMakeLists.txt; \
    repo=$(sed -n -e 's|.*GIT_REPOSITORY \([^ ]*\).*|\1|p' "$pin" | head -n1); \
    tag=$(sed -n -e 's|.*GIT_TAG \([^ ]*\).*|\1|p' "$pin" | head -n1); \
    test -n "$repo" || { echo "ERROR: no GIT_REPOSITORY in $pin" >&2; exit 1; }; \
    test -n "$tag"  || { echo "ERROR: no GIT_TAG in $pin" >&2; exit 1; }; \
    echo "librist pin (from rist-cpp/CMakeLists.txt): $repo @ $tag"; \
    git clone --depth 1 --branch "$tag" "$repo" rist; \
    cp test/rig/rist2rist-tool.c rist/tools/rist2rist.c; \
    grep -q 'out-profile' rist/tools/rist2rist.c \
      || { echo "ERROR: staged tool is not the patched production rist2rist" >&2; exit 1; }; \
    grep -q 'telemetry_emit' rist/tools/rist2rist.c \
      || { echo "ERROR: staged tool has no wan_telemetry emitter" >&2; exit 1; }

# Same meson switches as the production librist build, plus built_tools so
# tools/rist2rist is produced from the staged production source.
RUN meson setup build rist \
      -Ddefault_library=static -Dtest=false -Dbuilt_tools=true \
      -Dbuiltin_mbedtls=true -Dbuiltin_cjson=true -Dbuiltin_lz4=true \
      -Dc_args=-Wno-overlength-strings \
    && ninja -C build tools/rist2rist \
    && ./build/tools/rist2rist --help 2>&1 | grep -q 'out-profile' \
      || { echo "ERROR: built rist2rist does not report --out-profile" >&2; exit 1; }

FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    iproute2 iputils-ping conntrack binutils \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/build/tools/rist2rist /usr/local/bin/
COPY test/rig/bond.sh /usr/local/bin/bond.sh
RUN chmod +x /usr/local/bin/bond.sh
ENTRYPOINT ["bond.sh"]
